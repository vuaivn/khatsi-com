---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site, collectionsNav, categories } from '../config';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = allPosts.slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <h1 class="hero-h1">Khất Sĩ — Thư viện Phật pháp trực tuyến</h1>
    <p class="quote">"Chư ác mạc tác, chúng thiện phụng hành, tự tịnh kỳ ý — ấy lời chư Phật dạy."</p>
    <p class="quote-src">— Kinh Pháp Cú</p>
    <p class="intro">{site.description}</p>
    <div class="btn-row" style="margin-top:24px">
      <a href="/kinh-sach" class="btn">Vào thư viện</a>
      <a href="/gioi-thieu" class="btn ghost">Về Khất Sĩ</a>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">Thư viện</div>
      <h2>Các kho nội dung</h2>
    </div>
    <div class="tiles">
      {collectionsNav.map((c) => (
        <a href={c.link} class="tile">
          <div class="ico">{c.icon}</div>
          <h3>{c.title}</h3>
          <p>{c.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <div class="eyebrow">Mới cập nhật</div>
      <h2>Bài viết & luận giải</h2>
      <p class="sub">Phật học ứng dụng, tu tập và kinh điển</p>
    </div>
    {latest.length > 0 ? (
      <div class="post-cards">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="sub" style="text-align:center">Nội dung đang được cập nhật…</p>
    )}
    <div class="btn-row" style="margin-top:28px">
      <a href="/blog" class="btn ghost">Xem tất cả bài viết</a>
    </div>
  </section>

  <section class="section container">
    <div class="about-block">
      <h2>Về thư viện Khất Sĩ</h2>
      <p>
        Khất Sĩ là nơi lưu giữ và lan tỏa giáo lý nhà Phật một cách giản dị, dễ tiếp cận cho
        người học và người hành. Thư viện tập hợp <a href="/kinh-sach">kinh sách</a> cùng bản dịch
        công khai, các <a href="/blog">bài luận giải</a> Phật học ứng dụng, và
        <a href="/phap-am">pháp âm</a> bài giảng chọn lọc — tất cả biên soạn theo tinh thần
        thiểu dục tri túc, không thương mại hóa.
      </p>
      <p>
        Nếu bạn mới bắt đầu, hãy đọc các bài nền tảng như
        <a href="/blog/dao-phat-la-gi/">Đạo Phật là gì</a>,
        <a href="/blog/tu-dieu-de-la-gi/">Tứ Diệu Đế</a> và
        <a href="/blog/bat-chanh-dao-noble-eightfold/">Bát Chánh Đạo</a> để nắm cốt lõi con đường
        tu tập. Muốn đi sâu hơn, mời tham khảo các chủ đề
        <a href="/blog/category/kinh-dien/">Kinh điển</a>,
        <a href="/blog/category/phat-hoc/">Phật học</a> và
        <a href="/blog/category/tu-tap/">Tu tập</a> — từ thiền định, chánh niệm đến giáo lý duyên
        khởi, vô thường, vô ngã. Từ điển <a href="/thuat-ngu">thuật ngữ</a> giúp tra cứu nhanh các
        khái niệm khi đọc kinh.
      </p>
      <p>
        Nội dung được cập nhật thường xuyên. Chúng tôi tin rằng Phật pháp chỉ thật sự có ý nghĩa
        khi được đưa vào đời sống hằng ngày — trong cách ta suy nghĩ, nói năng và hành xử. Mong
        thư viện này là một người bạn đồng hành nhỏ trên con đường tỉnh thức của bạn.
      </p>
    </div>
  </section>
</BaseLayout>
